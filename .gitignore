# 运行数据
data/
*.db
*.db-shm
*.db-wal

# 前端
node_modules/
web/.pnpm-store/
.pnpm-store/
# dist 目录 gitignore，但保留占位文件 index.html（go:embed 需要，避免新克隆 go build 失败）
web/dist/*
!web/dist/index.html

# 环境
.env
.env.*
!.env.example
!**/.env.example
.pi-subagents/
.agents/
.impeccable/
.scratch/
.e2e-*/
.vscode/
/kanso

# 本地文档（默认不入版本管理）；运维备份文档作为项目交付物保留
docs/*
!docs/operations/
docs/operations/*
!docs/operations/backup-and-restore.md
CONTEXT.md

# 本地产物与临时文件
/kanas-new
/kanso-new
/kanso.exe
*.exe
/nul
temp/
.gocache/
.gocache-*/
.e2e-review-data*/
.data-drag-*/
designs/
skills-lock.json
*.log
playwright-report/
test-results/
web/screenshots/
web/test-results/
.codex-go-cache/

# 本地运行配置（可能包含访问密钥）
kanso-config.json

# Go 测试覆盖率产物
*.cover
*.coverprofile
*-cover
*-cover.html
*-cover.out
coverage.out
